{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "primitives": [
        "./src/vendor/mnoritake-ds/ui/primitives"
      ],
      "icons": [
        "./src/vendor/mnoritake-ds/ui/icons"
      ],
      "layout": [
        "./src/vendor/mnoritake-ds/ui/layout"
      ],
      "hooks": [
        "./src/vendor/mnoritake-ds/ui/hooks"
      ],
      "utils": [
        "./src/vendor/mnoritake-ds/ui/utils"
      ],
      "images": [
        "./src/vendor/mnoritake-ds/ui/images"
      ]
    },
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/vendor/**/stories"
  ]
}